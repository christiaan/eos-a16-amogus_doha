diff --git a/BoardConfig.mk b/BoardConfig.mk
index 9e00b92..b617293 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -31,6 +31,24 @@ ifneq ($(TARGET_PREBUILT_KERNEL),)
       $(wildcard device/motorola/amogus-kernel/modules/*.ko)
 endif
 
+# Kernel modules to load at boot, from the source-built kernel.
+# LineageOS's kernel.mk always writes vendor/lib/modules/modules.load
+# (vendor/lineage 01eef7f3), empty when this list is empty.
+# That empty file makes init.modprobe.sh skip its "load everything"
+# fallback and leaves vendor_modprobe.sh with nothing to load, so these
+# never loaded: the aw8695 haptics chip had no driver and the vibrator
+# did not work.
+# The FocalTech and Novatek touch drivers are for doha units without the
+# built-in Himax panel; each only binds when its panel is present.
+BOARD_VENDOR_KERNEL_MODULES_LOAD := \
+    aw8624 \
+    aw8695 \
+    sx933x_sar \
+    stmvl53l1 \
+    focaltech_0flash_mmi \
+    focaltech_0flash_mmi_doha \
+    nova_0flash_mmi
+
 # Partitions
 BOARD_VENDORIMAGE_PARTITION_SIZE := 620756992
 BOARD_SYSTEMIMAGE_PARTITION_SIZE := 3238002688
diff --git a/device.mk b/device.mk
index 9051022..3a6b5b6 100644
--- a/device.mk
+++ b/device.mk
@@ -27,7 +27,8 @@ TARGET_USES_FINGERPRINT_V2_1 := true
 # Overlays
 PRODUCT_PACKAGES += \
