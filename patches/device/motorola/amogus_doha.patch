diff --git a/rro_overlays/ApertureOverlays/doha_overlay/AndroidManifest.xml b/rro_overlays/ApertureOverlays/doha_overlay/AndroidManifest.xml
new file mode 100644
index 0000000..f88b30d
--- /dev/null
+++ b/rro_overlays/ApertureOverlays/doha_overlay/AndroidManifest.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Lets LineageOS's camera app (Aperture) use doha's ultra-wide
+     action camera, which the HAL exposes as auxiliary camera 3. -->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="org.lineageos.aperture.doha.overlay">
+    <application android:hasCode="false" />
+    <overlay
+        android:isStatic="true"
+        android:priority="10"
+        android:targetPackage="org.lineageos.aperture" />
+</manifest>
diff --git a/rro_overlays/ApertureOverlays/doha_overlay/res/values/config.xml b/rro_overlays/ApertureOverlays/doha_overlay/res/values/config.xml
new file mode 100644
index 0000000..4947f89
--- /dev/null
+++ b/rro_overlays/ApertureOverlays/doha_overlay/res/values/config.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Show the auxiliary cameras: camera 3 is the 16 MP ultra-wide
+         action camera (ov16885). -->
+    <bool name="config_enableAuxCameras">true</bool>
+
+    <!-- Camera 2 is the 5 MP depth sensor (s5k5e9). It only exists to
+         help the main camera with portrait blur, not to take pictures. -->
+    <string-array name="config_ignoredAuxCameraIds">
+        <item>2</item>
+    </string-array>
+</resources>
